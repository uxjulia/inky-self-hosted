# API storage. These paths are relative to the repository when using `npm run start`.
INKY_DATABASE_URL=sqlite:///./backend/storage/inky.db
INKY_DATA_DIR=./backend/storage

# Optional Basic Auth for self-hosted deployments.
# Leave both blank to disable auth.
INKY_AUTH_USERNAME=
INKY_AUTH_PASSWORD=
INKY_AUTH_REALM=Inky

# Optional folder to show as a read-only Local Library.
# Direct installs read this path directly. Docker Compose mounts this host path at /library.
INKY_MOUNTED_LIBRARY_DIR=

# Server address used by `npm run start`.
INKY_HOST=0.0.0.0

# Port to open in your browser. Docker Compose maps this to its web container automatically.
INKY_PORT=8000

# Private backend-backed UI: users can manage sources and send over Wi-Fi or USB.
# The full tool set, including Flash Tools, is available in this mode.
VITE_INKY_APP_MODE=self-hosted
VITE_INKY_DICTIONARY_TOOLS=1
