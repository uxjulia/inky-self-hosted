# Public URL for the browser app.
FRONTEND_PORT=3000

# Frontend deployment mode.
# Use self-hosted when the app should talk to the Inky backend.
# Use hosted only for the static browser-only app with no backend sources.
VITE_INKY_APP_MODE=self-hosted

# Library storage mode.
# Use browser for a public backend-backed app so each visitor keeps a private
# Local Library in their own browser. Leave blank for the shared backend library.
VITE_INKY_LIBRARY_MODE=

# Public read-only mode.
# Use 1 for public backend-backed deployments so visitors can browse seeded
# sources but cannot add/edit/delete sources or write to the backend library.
INKY_PUBLIC_READ_ONLY=0
VITE_INKY_PUBLIC_READ_ONLY=0

# API storage. SQLite lives inside this named volume by default.
INKY_DATABASE_URL=sqlite:////data/inky.db
INKY_DATA_DIR=/data

# Optional Basic Auth for self-hosted deployments.
# Leave both blank to disable auth.
INKY_AUTH_USERNAME=
INKY_AUTH_PASSWORD=
INKY_AUTH_REALM=Inky

# Optional host folder exposed as read-only books in Local Library.
INKY_LOCAL_LIBRARY_PATH=./library

# Optional folder scanned by the API as a mounted Local Library.
# Leave blank unless this points to a real book/image folder.
INKY_MOUNTED_LIBRARY_DIR=
