# API storage. SQLite lives inside this named volume by default.
INKY_DATABASE_URL=sqlite:////data/inky.db
INKY_DATA_DIR=/data

# Optional Basic Auth for self-hosted deployments.
# Leave both blank to disable auth.
INKY_AUTH_USERNAME=
INKY_AUTH_PASSWORD=
INKY_AUTH_REALM=Inky

# Public URL for the browser app.
FRONTEND_PORT=3000

# Frontend deployment mode.
# self-hosted: private backend-backed app with shared backend Local Library.
# public: public backend-backed app with read-only sources and browser-local files.
# hosted: static browser-only app with no backend sources.
VITE_INKY_APP_MODE=self-hosted

# Optional frontend-only feature flag for Dictionary Tools.
# Set to 1 to show the Dictionary Tools button in backend-backed builds.
VITE_INKY_DICTIONARY_TOOLS=0

# Advanced override for older/custom deployments.
# "public" mode already uses browser-local files. Leave blank otherwise unless
# you explicitly want browser-local files in another backend-backed mode.
VITE_INKY_LIBRARY_MODE=

# Backend public read-only mode.
# Set INKY_PUBLIC_READ_ONLY=1 for public backend-backed deployments so visitors
# can browse seeded sources but cannot add/edit/delete sources or write to the
# backend library. VITE_INKY_APP_MODE=public already applies the matching
# frontend behavior; VITE_INKY_PUBLIC_READ_ONLY is kept for older/custom builds.
INKY_PUBLIC_READ_ONLY=0

# Optional host folder exposed as read-only books in Local Library.
INKY_LOCAL_LIBRARY_PATH=./library

# Optional folder scanned by the API as a mounted Local Library.
# Leave blank unless you are running the backend directly or
# changing where the app should scan from inside its own runtime.
INKY_MOUNTED_LIBRARY_DIR=
