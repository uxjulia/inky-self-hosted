# API storage. SQLite lives inside this named volume by default.
INKY_DATABASE_URL=sqlite:////data/inky.db
INKY_DATA_DIR=/data

# Optional Basic Auth for self-hosted deployments.
# Leave both blank to disable auth.
INKY_AUTH_USERNAME=
INKY_AUTH_PASSWORD=
INKY_AUTH_REALM=Inky

# Public URL for the browser app.
FRONTEND_PORT=3000

# Frontend deployment mode used by Docker Compose.
VITE_INKY_APP_MODE=self-hosted

# Optional frontend-only feature flag for Dictionary Tools.
# Set to 1 to show the Dictionary Tools button in backend-backed builds.
VITE_INKY_DICTIONARY_TOOLS=0

# Optional host folder exposed as read-only books in Local Library.
INKY_LOCAL_LIBRARY_PATH=./library

# Optional folder scanned by the API as a mounted Local Library.
# Leave blank unless you are running the backend directly or
# changing where the app should scan from inside its own runtime.
INKY_MOUNTED_LIBRARY_DIR=
